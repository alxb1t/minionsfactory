# Local config & secrets — NEVER commit
.env

# Run artifacts written into the target repo — `events.jsonl`, the findings files, the
# HALT report and the deferred-work file. They are per-run output, not source, and a
# `git add -A` would otherwise sweep them into history. The gate command list is config
# and stays tracked.
.minions/*
!.minions/minions.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

.ruff_cache
.pytest_cache
