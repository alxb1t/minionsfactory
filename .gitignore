# Local config & secrets — NEVER commit
.env

# Run artifacts written into the target repo — `events.jsonl`, the findings files, the
# HALT report, the runner's per-version deferred-work file and the skills' `backlog.md`.
# They are run output, not source, and a `git add -A` would otherwise sweep them into
# history. The gate is the root `Makefile`'s `gate` target, so nothing under `.minions/`
# is tracked.
.minions/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

.ruff_cache
.pytest_cache
