# --- Obsidian vault path (the PM-side project folder Claude Code reads + edits) ---
# VAULT_PROJECT_DIR = the MinionsFactory project folder in the vault. It holds the product
# intent (prd/), the roles' findings/<change-id>_<role>.md, and the narrative record
# (log.md, overview.md, backlog.md, decisions.md). The work itself — the active change and
# its progress — lives in the repo, under openspec/changes/<id>/.
VAULT_PROJECT_DIR="/path/to/vault/Lab/minionsfactory"
